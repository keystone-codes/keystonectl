# Rendered by keystonectl. Do not edit the copy under sites-available.
# Substitutions: domain, upstream, host port, locations, healthz path, certificate, key.
# This HTTP site is written before a certificate exists so certbot --nginx can see server_name.

upstream __UPSTREAM__ {
    server 127.0.0.1:__HOST_PORT__;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location = __HEALTHZ_PATH__ {
        proxy_pass http://__UPSTREAM____HEALTHZ_PATH__;
        access_log off;
    }

    location / {
        return 404;
    }
}
