# Rendered by keystonectl. Do not edit the copy under sites-available.
# Substitutions: domain, upstream, host port, locations, healthz path, certificate, key.
# Port 80 redirects to 443 after the certificate is installed. certbot renewal matches server_name.

upstream __UPSTREAM__ {
    server 127.0.0.1:__HOST_PORT__;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;
    server_tokens off;

    ssl_certificate     __CERT_PATH__;
    ssl_certificate_key __KEY_PATH__;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;

__LOCATIONS__
    location = __HEALTHZ_PATH__ {
        proxy_pass http://__UPSTREAM____HEALTHZ_PATH__;
        access_log off;
    }

    location / {
        return 404;
    }
}
