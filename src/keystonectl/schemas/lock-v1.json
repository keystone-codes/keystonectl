{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keystone.codes/schemas/lock-v1.json",
  "title": "keystonectl services lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "layout_version",
    "updated_at",
    "updated_by",
    "layout",
    "services",
    "resources"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "layout_version": {"const": 1},
    "updated_at": {"$ref": "#/$defs/timestamp"},
    "updated_by": {"type": "string", "minLength": 1},
    "layout": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/layout"}
      ]
    },
    "services": {
      "type": "array",
      "items": {"$ref": "#/$defs/service"}
    },
    "resources": {
      "type": "array",
      "items": {"$ref": "#/$defs/resource"}
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "env_name": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flavor",
        "project",
        "compose_files",
        "keystone_service",
        "profiles",
        "keystone_image",
        "keystone_build",
        "keystone_mcp_version",
        "env_file",
        "policy",
        "upstreams_network"
      ],
      "properties": {
        "flavor": {
          "enum": ["keystone-mcp-example", "keystone-deploy", "custom"]
        },
        "project": {"type": "string", "minLength": 1},
        "compose_files": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "keystone_service": {"type": "string", "minLength": 1},
        "profiles": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "keystone_image": {"type": ["string", "null"]},
        "keystone_build": {"type": ["string", "null"]},
        "keystone_mcp_version": {"type": ["string", "null"]},
        "env_file": {"type": "string", "minLength": 1},
        "policy": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/policy"}
          ]
        },
        "upstreams_network": {"$ref": "#/$defs/upstreams_network"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "container_path"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "container_path": {"type": "string", "minLength": 1}
      }
    },
    "upstreams_network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "attached_by"],
      "properties": {
        "name": {"const": "keystone-mcp-upstreams"},
        "attached_by": {"enum": ["operator", "keystonectl"]},
        "include_default_network": {"type": "boolean"}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "managed"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "role": {"enum": ["service", "resource"]},
        "managed": {"enum": ["generated", "ejected", "remote"]},
        "source": {"type": "string", "minLength": 1},
        "package": {"type": "string", "minLength": 1},
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "ref": {"type": "string", "minLength": 1},
        "commit": {"$ref": "#/$defs/commit"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "compat_keystone_mcp": {"type": "string", "minLength": 1, "maxLength": 100},
        "containers": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/container"}
        },
        "fragment": {
          "type": "string",
          "pattern": "^packages/[a-z][a-z0-9-]*\\.yml$"
        },
        "fragment_sha256": {
          "anyOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "registry_name": {"type": ["string", "null"]},
        "namespace": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"]},
        "tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          }
        },
        "filters": {"$ref": "#/$defs/filters"},
        "env": {"$ref": "#/$defs/env"},
        "answers": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "resources": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["s3", "postgres"]}
        },
        "public": {"$ref": "#/$defs/public"},
        "retired_tools": {
          "type": "array",
          "items": {"type": "string"}
        },
        "previous": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/previous"}
          ]
        },
        "installed_at": {"$ref": "#/$defs/timestamp"},
        "updated_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "image", "init"],
      "properties": {
        "service": {"type": "string", "minLength": 1},
        "image": {"type": "string", "minLength": 1},
        "init": {"type": "boolean"}
      }
    },
    "filters": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tool_prefix": {"type": "string"},
            "include_prefixes": {
              "type": "array",
              "items": {"type": "string"}
            },
            "exclude_prefixes": {
              "type": "array",
              "items": {"type": "string"}
            },
            "strip_prefix": {"type": "string"}
          }
        }
      ]
    },
    "env": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keystone", "files", "generated"],
      "properties": {
        "keystone": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^KEYSTONE_MCP_UPSTREAM_[A-Z0-9_]+$"
          }
        },
        "files": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "generated": {
          "type": "array",
          "items": {"$ref": "#/$defs/env_name"}
        }
      }
    },
    "public": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {"enum": ["none", "pending", "ready"]},
        "domain": {"type": "string", "minLength": 1},
        "host_port": {"type": "integer", "minimum": 47600, "maximum": 47699},
        "dns": {"enum": ["checked", "skipped"]},
        "tls": {"enum": ["keep", "certbot", "custom", "manual"]},
        "cert_kind": {"type": "string", "minLength": 1},
        "cert_path": {"type": "string", "minLength": 1},
        "key_path": {"type": "string", "minLength": 1},
        "not_after": {"$ref": "#/$defs/timestamp"},
        "vhost": {"type": "string", "minLength": 1},
        "took_over": {"type": ["string", "null"]},
        "last_error": {"type": ["string", "null"]}
      }
    },
    "previous": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {"type": "string"},
        "ref": {"type": "string"},
        "commit": {"$ref": "#/$defs/commit"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "containers": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/container"}
        },
        "fragment_sha256": {
          "anyOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "tools": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "interface_version",
        "origin",
        "provider",
        "params",
        "consumers"
      ],
      "properties": {
        "kind": {"enum": ["s3", "postgres"]},
        "interface_version": {"const": 1},
        "origin": {"enum": ["catalog", "external"]},
        "provider": {"type": ["string", "null"]},
        "params": {"type": "object"},
        "consumers": {
          "type": "array",
          "items": {"type": "object"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"kind": {"const": "s3"}},
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["endpoint", "region", "path_style"],
                "properties": {
                  "endpoint": {"type": "string", "minLength": 1},
                  "region": {"type": "string", "minLength": 1},
                  "path_style": {"type": "boolean"}
                }
              },
              "consumers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["service", "bucket", "provisioned_at"],
                  "properties": {
                    "service": {"type": "string", "minLength": 1},
                    "bucket": {"type": "string", "minLength": 1},
                    "provisioned_at": {"$ref": "#/$defs/timestamp"}
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {"kind": {"const": "postgres"}},
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["host", "port", "sslmode"],
                "properties": {
                  "host": {"type": "string", "minLength": 1},
                  "port": {"type": "integer", "minimum": 1, "maximum": 65535},
                  "sslmode": {"type": "string", "minLength": 1}
                }
              },
              "consumers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["service", "database", "user", "extensions", "provisioned_at"],
                  "properties": {
                    "service": {"type": "string", "minLength": 1},
                    "database": {"type": "string", "minLength": 1},
                    "user": {"type": "string", "minLength": 1},
                    "extensions": {
                      "type": "array",
                      "items": {"type": "string"}
                    },
                    "provisioned_at": {"$ref": "#/$defs/timestamp"}
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
