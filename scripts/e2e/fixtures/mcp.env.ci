# CI stand-in for the keys setup.sh::write_mcp_env writes after D01.
# The e2e script replaces __BASE_URL__, __SALT__, and __PG_PASSWORD__ at runtime.
# Do not put a real password in this file.
KEYSTONE_MCP_BASE_URL=__BASE_URL__
KEYSTONE_MCP_HTTP_PATH=/
KEYSTONE_MCP_DEPLOYMENT_PROFILE=production
KEYSTONE_MCP_RBAC_MODE=enforce
KEYSTONE_MCP_RBAC_AUDIT_SUBJECT_SALT=__SALT__
KEYSTONE_MCP_SUPERADMIN_EMAIL=admin@example.com
KEYSTONE_MCP_REDIS_URL=redis://redis:6379/1
KEYSTONE_MCP_USERS_DB_URL=postgresql+psycopg://keystone:__PG_PASSWORD__@keystone-mcp-postgres:5432/keystone
KEYSTONE_PG_PASSWORD=__PG_PASSWORD__
KEYSTONE_MCP_UPSTREAM_ALLOW_INSECURE_HTTP=true
KEYSTONE_MCP_METRICS_ENABLED=true
KEYSTONE_MCP_ENABLED_LOGIN_METHODS=api_key
KEYSTONE_MCP_PRIMARY_LOGIN_METHOD=api_key
