schema_version: 1
name: e2e-partner
description: Partner catalog used by the e2e script.
packages:
  hello-upstream:
    kind: service
    summary: Demo MCP service with no storage.
    source: @HELLO_SOURCE@
    versions:
      - {version: 1.0.0, ref: @HELLO_REF@, keystone_mcp: ">=0.5.0,<2.0"}
  file-mcp:
    kind: service
    summary: Upload and download links for large files on S3-compatible storage.
    source: @FILE_SOURCE@
    versions:
      - {version: 1.0.0, ref: @FILE_REF@, keystone_mcp: ">=0.5.0,<2.0"}
